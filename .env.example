# Front-end
# "true" (padrão) = dados simulados no navegador, sem back-end. "false" = usa /api/gas.
VITE_DEMO=true
VITE_SITE_URL=

# Vercel Functions (fases 3 e 6)
GAS_URL=
GAS_API_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Pagamentos online (Asaas) — só no servidor (Vercel). NUNCA no código nem com prefixo VITE_.
# Teste com a conta de homologação (sandbox): chave $aact_hmlg_... e ASAAS_AMBIENTE=sandbox.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token escolhido por você (32+ caracteres) e informado também ao criar o webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=
